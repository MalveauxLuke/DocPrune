# Copy into the ignored correction data folder; fill paths after inspecting H200 storage.
export CORRECTION_CODE=/mnt/data1/eunwooim/DocPrune
export CORRECTION_DATA=$CORRECTION_CODE/task9-h200-local-data/correction-depth40
export CORRECTION_PACKAGE=$CORRECTION_DATA/transferred-inputs
export CORRECTION_FIXED=$CORRECTION_DATA/fixed
export CORRECTION_RESULTS=$CORRECTION_DATA/results
export CORRECTION_PREP=$CORRECTION_DATA/preparation
export CORRECTION_PYTHON=/mnt/data2/eunwooim/.conda/envs/docprune-h200/bin/python
export CORRECTION_MINERU=/mnt/data2/eunwooim/.conda/envs/mineru-h200/bin/mineru
# Existing metadata and tool/model inventory, not the global index bytes.
export CORRECTION_RUN_CONFIG=/mnt/data1/eunwooim/DocPrune/task9-h200-local-data/manifests/run-config.json
export CORRECTION_INDEX_MANIFEST=/mnt/data1/eunwooim/DocPrune/task9-h200-local-data/manifests/index-manifest.json
# Set to an existing pinned MinerU run/preparation manifest on H200:
export CORRECTION_MINERU_MANIFEST=
# Existing transferred Poppler bin directory; pdftoppm SHA must match Task 6.
export DOCPRUNE_TASK6_POPPLER_BIN=
# Existing transfer root; lookup is read-only and checks exact asset hashes.
export CORRECTION_REUSE_ROOT=/mnt/data1/eunwooim/DocPrune/task9-h200-local-data
export DOCPRUNE_M3DOCRAG_ROOT=/mnt/data1/eunwooim/DocPrune/task9-h200-local-data/tools/m3docrag
export HF_HOME=/mnt/data2/eunwooim/hf-cache
export HUGGINGFACE_HUB_CACHE=$HF_HOME/hub
export TRANSFORMERS_CACHE=$HF_HOME/transformers
export TORCH_HOME=/mnt/data2/eunwooim/torch-cache
export XDG_CACHE_HOME=/mnt/data2/eunwooim/xdg-cache
export TMPDIR=/mnt/data2/eunwooim/tmp/correction-depth
export PYTHONPATH=$CORRECTION_CODE/src
